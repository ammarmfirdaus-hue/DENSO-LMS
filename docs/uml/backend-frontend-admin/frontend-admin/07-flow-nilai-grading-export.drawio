      <mxCell id="term_10292" value="&lt;b&gt;BUKA HALAMAN NILAI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="109" y="174" width="220" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10293" value="&lt;b&gt;Tarik Snapshot Nilai Dual-DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /grades -&amp;gt; Kueri SQL Server&lt;br&gt;student_progress_snapshots + courses&lt;br&gt;(Admin: seluruh | Teacher: miliknya)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="74" y="250" width="290" height="84" as="geometry"/></mxCell>
      <mxCell id="proc_10294" value="&lt;b&gt;Filter Daftar &amp;amp; Kolom Nilai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan Progres %, quiz &amp;amp; akhir&lt;br&gt;Auto-reload saat batch hapus selesai&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="74" y="368" width="290" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10295" value="&lt;b&gt;Pilih Aksi di&lt;br&gt;Halaman Nilai?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="485" width="198" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10296" value="&lt;b&gt;Buka Modal Nilai &amp;amp; Feedback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Input score (0..100) &amp;amp; catatan &amp;lt;= 1000 kar&lt;br&gt;Kirim PATCH /grades/:npk/:courseCode&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10297" value="&lt;b&gt;Origin &amp;amp; Skor&lt;br&gt;0..100 Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="534" y="256" width="190" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10298" value="&lt;b&gt;Tolak HTTP 400 / 403 / 404&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Nilai di luar rentang 0-100 atau tak berhak&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="412" width="316" height="62" as="geometry"/></mxCell>
      <mxCell id="proc_10299" value="&lt;b&gt;Simpan ke Snapshot SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;UPDATE dbo.student_progress_snapshots&lt;br&gt;SET score, grade_feedback, graded_by, at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="514" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10300" value="&lt;b&gt;Immediate Reverse Sync ke MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jalankan syncStudentGradeNow(npk, course)&lt;br&gt;Dorong langsung score &amp;amp; feedback ke tabel&lt;br&gt;course_enrollments Portal Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="636" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10301" value="&lt;b&gt;Aksi: Hapus Nilai&lt;br&gt;vs Kirim Notif?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="174" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10302" value="&lt;b&gt;Admin Hapus Nilai&lt;br&gt;Single vs Bulk?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="942" y="292" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10303" value="&lt;b&gt;Single Delete Nilai (Admin Only)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;DELETE /grades/:npk/:courseCode -&amp;gt; Kosongkan&lt;br&gt;score &amp;amp; feedback lalu reverse sync ke MySQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="887" y="416" width="304" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10304" value="&lt;b&gt;Bulk Delete via Antrean Job Aman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /jobs/records/delete (kind=&amp;quot;grade&amp;quot;)&lt;br&gt;Bersihkan nilai massal tanpa hapus progres&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="887" y="524" width="304" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10305" value="&lt;b&gt;Modal Kirim Notifikasi / Email Nilai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Input judul, isi pesan &amp;amp; opsi sendEmail SMTP&lt;br&gt;POST /grades/:npk/:courseCode/notify&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="887" y="650" width="304" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10306" value="&lt;b&gt;Simpan Notif + SSE &amp;amp; Kirim Email&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT dbo.lms_notifications + SSE Student&lt;br&gt;Jika sendEmail aktif -&amp;gt; kirim via SMTP Outbox&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="887" y="774" width="304" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10307" value="&lt;b&gt;Klik Ekspor Excel (.xlsx)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil baris terfilter saat ini dari tabel Nilai&lt;br&gt;Panggil fungsi buildGradesXlsx() di client&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10308" value="&lt;b&gt;Bangun Paket OOXML Lokal Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Susun worksheet XML, sharedStrings &amp;amp; ZIP&lt;br&gt;dengan kolom NPK, Course, Quiz, Nilai, Feedback&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="294" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10309" value="&lt;b&gt;Unduh File .xlsx di Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Buat Blob ObjectURL &amp;amp; simpan file langsung&lt;br&gt;tanpa membebani CPU server backend&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="424" width="316" height="70" as="geometry"/></mxCell>
