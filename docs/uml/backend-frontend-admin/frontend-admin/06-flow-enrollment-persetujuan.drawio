      <mxCell id="term_10246" value="&lt;b&gt;BUKA MENU ENROLLMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="109" y="166" width="220" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10247" value="&lt;b&gt;Muat Permintaan &amp;amp; Rekomendasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /enrollments/requests?status=all/pending&lt;br&gt;Auto-polling tiap 15 detik + refresh saat focus&lt;br&gt;jendela browser aktif kembali&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="dia_10248" value="&lt;b&gt;Sumber &amp;amp; Aksi&lt;br&gt;Permintaan Akses?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="373" width="194" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10249" value="&lt;b&gt;Request Self-Enroll dari Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Masukan pengajuan akses dari Portal Student&lt;br&gt;(/student/course/detail) status awal = pending&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="560" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10250" value="&lt;b&gt;Teacher Muat Opsi Student &amp;amp; Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /enrollments/options -&amp;gt; Ambil daftar course&lt;br&gt;milik Teacher serta top 50 student aktif&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="200" width="320" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10251" value="&lt;b&gt;Kirim Rekomendasi Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /enrollments/recommendations&lt;br&gt;Isi: studentNpk, courseCode dan note &amp;lt;= 1000 kar&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="324" width="320" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10252" value="&lt;b&gt;Course Milik&lt;br&gt;Teacher &amp;amp; Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="532" y="438" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10253" value="&lt;b&gt;Tolak Rekomendasi (400 / 403 / 404)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;403 Untrusted Origin | 404 Course bukan akses&lt;br&gt;Teacher -&amp;gt; Tampilkan pesan alert pada modal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="608" width="320" height="66" as="geometry"/></mxCell>
      <mxCell id="proc_10254" value="&lt;b&gt;Rekomendasi Tersimpan (HTTP 201)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT request status=pending -&amp;gt; Tampil di&lt;br&gt;daftar tunggu persetujuan Admin pusat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="720" width="320" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10255" value="&lt;b&gt;Admin Tinjau Request Pending&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan catatan Student atau Rekomendasi&lt;br&gt;Pilih Setujui (approve) atau Tolak (reject)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="200" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10256" value="&lt;b&gt;Pilihan Admin:&lt;br&gt;Setujui / Tolak?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="942" y="311" width="194" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10257" value="&lt;b&gt;Alasan Tolak&lt;br&gt;&amp;gt;= 3 Karakter?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="466" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10258" value="&lt;b&gt;Tolak HTTP 400 Invalid Input&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Alasan penolakan &amp;gt;= 3 karakter&lt;br&gt;Agar Student tahu revisi akses&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="916" y="636" width="246" height="66" as="geometry"/></mxCell>
      <mxCell id="proc_10259" value="&lt;b&gt;Kirim Keputusan Admin ke API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /enrollments/:requestId/decision&lt;br&gt;Verifikasi Origin + Role Admin Only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="746" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10260" value="&lt;b&gt;Jika Disetujui: Aktifkan Akses Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Update status=approved di request SQL Server&lt;br&gt;UPSERT course_enrollments di MySQL sehingga&lt;br&gt;has_access langsung terbuka di Portal Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="240" width="320" height="84" as="geometry"/></mxCell>
      <mxCell id="proc_10261" value="&lt;b&gt;Jika Ditolak: Simpan Catatan Tolak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Update status=rejected + rejection_note&lt;br&gt;Student dapat ajukan ulang pada Detail Course&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="380" width="320" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10262" value="&lt;b&gt;Catat Notifikasi Student SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT dbo.lms_notifications (category course,&lt;br&gt;priority important, target=student)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="520" width="320" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10263" value="&lt;b&gt;Push Event Notifikasi Realtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kirim event notifikasi ke SSE Student agar&lt;br&gt;status persetujuan langsung muncul seketika&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="664" width="320" height="76" as="geometry"/></mxCell>
