      <mxCell id="zone_10004" value="4. PORTAL AKTIF &amp; STUDY MODE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10005" value="&lt;b&gt;BUKA PORTAL SPA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="114" y="164" width="210" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10006" value="&lt;b&gt;Muat Runtime Config &amp;amp; Service Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /settings/runtime-config (apiBaseUrl)&lt;br&gt;Daftar PWA Service Worker &amp;amp; Tema Lokal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="152" width="316" height="68" as="geometry"/></mxCell>
      <mxCell id="dia_10007" value="&lt;b&gt;Rute URL =&lt;br&gt;/review/:token?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="951" y="148" width="176" height="76" as="geometry"/></mxCell>
      <mxCell id="term_10008" value="&lt;b&gt;MASUK PORTAL REVIEWER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1319" y="164" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10009" value="&lt;b&gt;Pulihkan Sesi Aktif SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /auth/me (Cookie dls_sso HttpOnly)&lt;br&gt;Auto-refresh token bila sesi masih berlaku&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="290" width="316" height="68" as="geometry"/></mxCell>
      <mxCell id="dia_10010" value="&lt;b&gt;Sesi JWT&lt;br&gt;Aktif &amp;amp; Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="951" y="287" width="176" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10011" value="&lt;b&gt;Role Akun =&lt;br&gt;student vs staff?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1357" y="286" width="184" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10012" value="&lt;b&gt;Render Form LoginPage SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Input NPK &amp;amp; Password + Toggle Lihat Sandi&lt;br&gt;Kirim POST /auth/login (credentials: include)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="440" width="316" height="72" as="geometry"/></mxCell>
      <mxCell id="dia_10013" value="&lt;b&gt;Input Valid &amp;amp;&lt;br&gt;Limit &amp;lt;= 8 / 15m?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="532" y="438" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10014" value="&lt;b&gt;Tolak Permintaan Login (400 / 429)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;HTTP 400 Invalid Input atau 429 Lockout 15m&lt;br&gt;Tampilkan alert kegagalan di LoginPage&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="616" width="316" height="64" as="geometry"/></mxCell>
      <mxCell id="proc_10015" value="&lt;b&gt;Verifikasi Dual-DB &amp;amp; Hash Sandi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek dbo.employee_accounts (admin/teacher)&lt;br&gt;atau MySQL student_accounts + bcrypt compare&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="879" y="440" width="320" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10016" value="&lt;b&gt;NPK &amp;amp; Sandi&lt;br&gt;Cocok + Aktif?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="951" y="565" width="176" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10017" value="&lt;b&gt;Catat Login Gagal &amp;amp; Tolak 401&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;HTTP 401 Kredensial Salah -&amp;gt; Hapus token Auth&lt;br&gt;dan tampilkan peringatan di halaman login&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="674" width="316" height="56" as="geometry"/></mxCell>
      <mxCell id="proc_10018" value="&lt;b&gt;Redirect Ke Native PHP Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Bersihkan token Auth -&amp;gt; Arahkan browser ke&lt;br&gt;URL Portal Student (VITE_STUDENT_APP_URL)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="456" width="316" height="66" as="geometry"/></mxCell>
      <mxCell id="term_10019" value="&lt;b&gt;PORTAL STUDENT :8082&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1319" y="560" width="260" height="42" as="geometry"/></mxCell>
      <mxCell id="proc_10020" value="&lt;b&gt;Terbit JWT &amp;amp; Set Cookie SSO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Sign JWT HS256 + Cookie dls_sso HttpOnly&lt;br&gt;Buka halaman utama &amp;quot;/&amp;quot; sesuai hak akses RBAC&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="648" width="320" height="70" as="geometry"/></mxCell>
      <mxCell id="proc_10021" value="&lt;b&gt;Masuk AppLayout &amp;amp; Sidebar RBAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Saring grup menu Admin vs Teacher&lt;br&gt;Aktifkan SSE /notifications &amp;amp; /activity&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="780" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10022" value="&lt;b&gt;Aksi Akun pada&lt;br&gt;Header / Sidebar?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="121" y="899" width="196" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10023" value="&lt;b&gt;Edit Profil &amp;amp; Ganti Kata Sandi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Modal Profil -&amp;gt; PUT /auth/profile&lt;br&gt;Verifikasi sandi lama + bcrypt hash baru&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="899" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10024" value="&lt;b&gt;Konfirmasi &amp;amp; Logout SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Dialog Konfirmasi -&amp;gt; POST /auth/logout (204)&lt;br&gt;Hapus cookie dls_sso dan arahkan ke /login&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="1054" width="316" height="64" as="geometry"/></mxCell>
      <mxCell id="proc_10025" value="&lt;b&gt;Teacher Klik Mode Belajar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /auth/student-mode (Khusus Teacher)&lt;br&gt;Validasi Origin &amp;amp; status keaktifan Teacher&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="879" y="899" width="320" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10026" value="&lt;b&gt;Buat Akun Shadow &amp;amp; Cookie 30m&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan akun teacher_shadow aktif di MySQL&lt;br&gt;Terbit JWT 30m (teacher_student) -&amp;gt; Portal Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1289" y="899" width="320" height="78" as="geometry"/></mxCell>
