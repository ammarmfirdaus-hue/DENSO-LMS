      <mxCell id="term_10107" value="&lt;b&gt;BUKA MENU COURSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="109" y="166" width="220" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10108" value="&lt;b&gt;Muat Daftar Course Sesuai Role&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /courses dan /dashboard/courses&lt;br&gt;Admin: seluruh | Teacher: dibuat atau diampu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10109" value="&lt;b&gt;Cari &amp;amp; Filter Wajib / Pilihan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Filter kode, judul, nama trainer &amp;amp; kategori&lt;br&gt;Tampilkan statistik sesi dan materi per kartu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10110" value="&lt;b&gt;Pilih Aksi di&lt;br&gt;Halaman Course?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="463" width="194" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10111" value="&lt;b&gt;Buka Halaman Detail Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /courses/:id/detail &amp;amp; /sessions&lt;br&gt;Verifikasi kepemilikan akses courseAccess()&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="174" width="320" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10112" value="&lt;b&gt;Aksi Kelola di&lt;br&gt;Detail Course?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="273" width="196" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10113" value="&lt;b&gt;Tambah atau Urutkan Sesi Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /courses/:id/sessions (title, sort_order)&lt;br&gt;Susun daftar sesi topik pembelajaran course&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="434" width="320" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10114" value="&lt;b&gt;Ajukan Materi Baru ke Sesi Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Buka Modal Pengajuan Materi per sesi&lt;br&gt;Kirim pengajuan ke alur Review Admin/Reviewer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="550" width="320" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10115" value="&lt;b&gt;Inspeksi Materi Terbit di Sesi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Buka Modal Detail Materi Terbit&lt;br&gt;Pratinjau file PDF, Video atau link YouTube&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="274" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10116" value="&lt;b&gt;Admin / Teacher&lt;br&gt;Hapus Materi?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="378" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10117" value="&lt;b&gt;Hapus Transaksional SQL &amp;amp; Disk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;DELETE /material-workflow/published/:id&lt;br&gt;Hapus baris dbo.course_materials &amp;amp; file fisik&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="540" width="312" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10118" value="&lt;b&gt;Nonaktifkan Materi di MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jalankan deleteStudentMaterial (is_active = 0)&lt;br&gt;Progres materi tak lagi mengunci Quiz Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="676" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10119" value="&lt;b&gt;Buka Modal Buat Course Baru&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Input courseCode, title, description,&lt;br&gt;kategori Wajib/Pilihan &amp;amp; opsional trainerNpk&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10120" value="&lt;b&gt;Isi trainerNpk?&lt;br&gt;Role = Admin?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="266" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10121" value="&lt;b&gt;Tolak Request (403 / 400 / 409)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;403 Butuh Admin | 400 Trainer nonaktif&lt;br&gt;409 Kode course sudah terdaftar SQL Server&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="408" width="312" height="64" as="geometry"/></mxCell>
      <mxCell id="proc_10122" value="&lt;b&gt;Simpan Course &amp;amp; Audit Log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /courses -&amp;gt; INSERT tabel dbo.courses&lt;br&gt;dan catat dbo.activity_logs (course_created)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="516" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10123" value="&lt;b&gt;Worker Sinkron Katalog ke Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Sinkronkan data courses dan course_sessions&lt;br&gt;ke database MySQL Portal Native Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="650" width="312" height="72" as="geometry"/></mxCell>
