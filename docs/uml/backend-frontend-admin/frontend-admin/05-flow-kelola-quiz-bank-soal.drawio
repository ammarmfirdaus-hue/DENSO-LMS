      <mxCell id="term_10198" value="&lt;b&gt;BUKA HALAMAN QUIZ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="109" y="164" width="220" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10199" value="&lt;b&gt;Ambil Daftar Course &amp;amp; Info Quiz&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /quizzes -&amp;gt; Gabung SQL Server courses&lt;br&gt;dengan MySQL course_quizzes &amp;amp; jumlah attempt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="244" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10200" value="&lt;b&gt;Cari, Filter Status &amp;amp; Pagination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Status: missing / draft / published / inactive&lt;br&gt;Auto-reload saat event Job Queue selesai&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="360" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10201" value="&lt;b&gt;Aksi Staf di&lt;br&gt;Daftar Quiz?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="476" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10202" value="&lt;b&gt;Muat Detail Soal Quiz Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /quizzes/:courseCode (Cek akses course)&lt;br&gt;Isi form editor React dengan soal &amp;amp; opsi PG&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="164" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10203" value="&lt;b&gt;Susun Soal, Opsi &amp;amp; Skor Lulus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;1..100 Soal, 2..6 Opsi PG + pilih kunci jawaban&lt;br&gt;Atur passingScore (0-100) &amp;amp; status draft/pub&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="276" width="316" height="84" as="geometry"/></mxCell>
      <mxCell id="dia_10204" value="&lt;b&gt;Origin + Schema&lt;br&gt;Valid &amp;amp; Kunci OK?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="395" width="198" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10205" value="&lt;b&gt;Tolak Validasi Editor (400 / 403)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;403 Origin tak dipercaya | 400 Kunci di luar&lt;br&gt;rentang opsi -&amp;gt; Perbaiki input di modal editor&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="566" width="316" height="66" as="geometry"/></mxCell>
      <mxCell id="proc_10206" value="&lt;b&gt;Kirim Simpan Bank Soal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST atau PUT /quizzes/:courseCode&lt;br&gt;Buka transaksi koneksi MySQL Quiz Store&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="885" y="276" width="308" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10207" value="&lt;b&gt;UPSERT course_quizzes &amp;amp; Opsi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Simpan title, passing_score dan status quiz&lt;br&gt;Replace course_quiz_questions &amp;amp; quiz_options&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="885" y="396" width="308" height="84" as="geometry"/></mxCell>
      <mxCell id="dia_10208" value="&lt;b&gt;Status Quiz =&lt;br&gt;published?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="944" y="521" width="190" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10209" value="&lt;b&gt;Quiz Terbuka di Portal Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Student bisa mengerjakan setelah seluruh&lt;br&gt;materi course selesai 100% (1x Attempt)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="885" y="690" width="308" height="70" as="geometry"/></mxCell>
      <mxCell id="proc_10210" value="&lt;b&gt;Tersimpan Sebagai Draft Internal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Belum ditampilkan kepada Student hingga rilis&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="885" y="816" width="308" height="66" as="geometry"/></mxCell>
      <mxCell id="dia_10211" value="&lt;b&gt;Single Delete atau&lt;br&gt;Bulk Admin Job?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1352" y="176" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10212" value="&lt;b&gt;Antrekan Bulk Delete Quiz Aman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /jobs/records/delete (Admin Only)&lt;br&gt;kind=&amp;quot;quiz&amp;quot; -&amp;gt; Enkripsi AES-256-GCM (HTTP 202)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1295" y="344" width="308" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10213" value="&lt;b&gt;Periksa Jumlah Attempt Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;SELECT COUNT(attempt_id) dari tabel&lt;br&gt;course_quiz_attempts berdasarkan quiz_id&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1295" y="474" width="308" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10214" value="&lt;b&gt;attempt_count&lt;br&gt;&amp;gt; 0?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1357" y="585" width="184" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10215" value="&lt;b&gt;Nonaktifkan Quiz (Proteksi Nilai)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;UPDATE course_quizzes SET status='inactive'&lt;br&gt;Riwayat jawaban &amp;amp; nilai Student tetap terjaga&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1295" y="746" width="308" height="72" as="geometry"/></mxCell>
