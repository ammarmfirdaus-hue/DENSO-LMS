      <mxCell id="term_10058" value="&lt;b&gt;STAF MASUK PORTAL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="114" y="174" width="210" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10059" value="&lt;b&gt;Render Sidebar RBAC &amp;amp; Live Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Saring Menu Admin vs Teacher sesuai hak akses&lt;br&gt;Tanggal ID realtime, Live Search &amp;amp; Pin Sidebar&lt;br&gt;Serta toggle Tema Terang / Gelap lokalStorage&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="63" y="250" width="312" height="86" as="geometry"/></mxCell>
      <mxCell id="dia_10060" value="&lt;b&gt;Pilih Menu / Widget&lt;br&gt;di Portal SPA?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="373" width="194" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10061" value="&lt;b&gt;Muat Paralel Halaman Dashboard (/)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /dashboard/summary, /dashboard/courses&lt;br&gt;dan /dashboard/activity secara bersamaan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="468" y="174" width="322" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10062" value="&lt;b&gt;Filter Scope =&lt;br&gt;Admin vs Teacher?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="532" y="275" width="194" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10063" value="&lt;b&gt;Kueri Statistik Terfilter SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Admin: seluruh data course &amp;amp; karyawan aktif&lt;br&gt;Teacher: hanya course yang dibuat/diampu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="468" y="424" width="322" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10064" value="&lt;b&gt;Render Kartu Statistik &amp;amp; Grafik Bar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jumlah Course, Sesi, Materi &amp;amp; Pegawai&lt;br&gt;Daftar aktivitas terbaru + tautan cepat modul&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="468" y="550" width="322" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10065" value="&lt;b&gt;Ada Event SSE /&lt;br&gt;Job Selesai?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="537" y="658" width="184" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10066" value="&lt;b&gt;Muat Feed Log Aktivitas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /dashboard/activity?limit=100&lt;br&gt;Gabung audit_logs, antrean Job &amp;amp; riwayat Login&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="878" y="174" width="322" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10067" value="&lt;b&gt;Filter Tab Status &amp;amp; Pencarian&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tab: Semua / Antrean / Gagal / Selesai&lt;br&gt;Cari NPK / deskripsi + Filter jenis aksi log&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="878" y="290" width="322" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10068" value="&lt;b&gt;Langganan SSE Aktivitas Realtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;EventSource /dashboard/activity/events&lt;br&gt;Batas 2 koneksi/user (429), Poll DB tiap 4 detik&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="878" y="412" width="322" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10069" value="&lt;b&gt;Terima Event&lt;br&gt;Aktivitas Baru?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="944" y="523" width="190" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10070" value="&lt;b&gt;Emit Event Browser &amp;amp; Segarkan UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Trigger window event dls_activity_changed&lt;br&gt;Tampilkan toast baru &amp;amp; muat ulang tabel log&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="878" y="682" width="322" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10071" value="&lt;b&gt;Muat Antrean Job Latar Belakang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /jobs (Top 30 milik user / semua Admin)&lt;br&gt;Buka widget melayang JobsCenter di layar SPA&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10072" value="&lt;b&gt;Ada Job Status&lt;br&gt;queued / running?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1354" y="275" width="190" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10073" value="&lt;b&gt;Hubungkan SSE Progress Job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;EventSource /jobs/:id/stream (update tiap 1s)&lt;br&gt;Terima persentase &amp;amp; progres per baris item&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="424" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10074" value="&lt;b&gt;User Klik Stop /&lt;br&gt;Resume Antrean?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1354" y="523" width="190" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10075" value="&lt;b&gt;Kirim Kontrol Stop atau Resume&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /jobs/:id/stop atau POST /jobs/:id/resume&lt;br&gt;Worker berhenti/lanjut aman di batas item&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="682" width="312" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10076" value="&lt;b&gt;Event Selesai -&amp;gt; Sinkronkan Halaman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Dispatch browser event dls_job_settled&lt;br&gt;Auto-reload Users, Grades, Quizzes &amp;amp; Materials&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="814" width="312" height="74" as="geometry"/></mxCell>
