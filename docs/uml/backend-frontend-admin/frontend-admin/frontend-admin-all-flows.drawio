      <mxCell id="dia_10381" value="&lt;b&gt;Pilih Menu /users&lt;br&gt;vs /reviewers?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="236" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10382" value="&lt;b&gt;Muat Daftar &amp;amp; Statistik Pengguna&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /users -&amp;gt; Hitung total, aktif &amp;amp; peran&lt;br&gt;Teacher hanya melihat daftar Student aktif&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="69" y="396" width="300" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10383" value="&lt;b&gt;Pilih Aksi&lt;br&gt;di /users?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="122" y="511" width="194" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10384" value="&lt;b&gt;Upload &amp;amp; Parse CSV Massal (max 5000)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Wajib 6 kolom (NPK, Nama, Email, Role, Status,&lt;br&gt;Password) -&amp;gt; Preview tabel baris valid/error&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10385" value="&lt;b&gt;Bulk Action: Upsert / Nonaktif / Hapus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Teacher: hanya aksi Student tanpa sendEmail&lt;br&gt;Admin: semua peran (Admin/Teacher/Reviewer)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="286" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10386" value="&lt;b&gt;Modal Tambah / Edit Akun User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Validasi kata sandi min 12 karakter, cegah&lt;br&gt;nonaktifkan diri sendiri (CANNOT_DISABLE_SELF)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="412" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10387" value="&lt;b&gt;Promosi Akun:&lt;br&gt;Student -&amp;gt; Teacher?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="502" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10388" value="&lt;b&gt;Transaksi Promosi SERIALIZABLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT dbo.employee_accounts (teacher) &amp;amp;&lt;br&gt;ubah akun Student menjadi teacher_shadow agar&lt;br&gt;riwayat belajar &amp;amp; nilai sebelumnya tetap utuh&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="660" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10389" value="&lt;b&gt;Enkripsi Payload &amp;amp; Antre Job Batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /jobs/users (AES-256-GCM encrypted)&lt;br&gt;Kembalikan HTTP 202 (jobId, status=&amp;quot;queued&amp;quot;)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="260" width="316" height="86" as="geometry"/></mxCell>
      <mxCell id="proc_10390" value="&lt;b&gt;Worker Eksekusi Item per Item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jalankan CRUD SQL Server &amp;amp; MySQL per baris&lt;br&gt;Nonaktifkan akun bila punya jejak riwayat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="396" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10391" value="&lt;b&gt;Flag sendEmail&lt;br&gt;Aktif &amp;amp; Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="946" y="509" width="186" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10392" value="&lt;b&gt;Kirim Email Kredensial Akun SMTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Nodemailer kirim NPK, peran &amp;amp; sandi awal ke&lt;br&gt;email pengguna baru atau hasil reset sandi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="674" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10393" value="&lt;b&gt;Guard Route /reviewers (Admin Only)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek hak kelola khusus Admin penuh&lt;br&gt;Jika bukan Admin -&amp;gt; redirect keluar halaman&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10394" value="&lt;b&gt;Muat Daftar Reviewer &amp;amp; KPI Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /reviewers (Admin Only) -&amp;gt; Statistik&lt;br&gt;total_reviews dan active_reviews tiap Reviewer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="286" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10395" value="&lt;b&gt;Tambah / Edit Profil Reviewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST atau PUT /reviewers -&amp;gt; NPK, Departemen,&lt;br&gt;Jabatan, Telp, Email + bcrypt hash cost 12&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="404" width="312" height="80" as="geometry"/></mxCell>
