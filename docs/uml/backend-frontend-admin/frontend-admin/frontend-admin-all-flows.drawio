      <mxCell id="hdr_title" value="FLOWCHART 10 (ADMIN &amp; FRONTEND) - NOTIFIKASI, BROADCAST &amp; PENGATURAN API" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="23" width="1024" height="26" as="geometry"/></mxCell>
      <mxCell id="hdr_sub" value="Alur SSE Notifikasi, Modal Popup, Broadcast Rate Limit 10/jam + SMTP &amp; Pengaturan Base URL / Sync (/settings/api)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=10.2;" vertex="1" parent="1"><mxGeometry x="44" y="50" width="1024" height="20" as="geometry"/></mxCell>
      <mxCell id="leg_box" value="STANDAR ISO 5807 MONOKROM: Kapsul = Mulai / Selesai   |   Kotak = Proses / API / DB   |   Belah Ketupat = Keputusan   |   Putus-Putus = Async / SSE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1082" y="26" width="556" height="48" as="geometry"/></mxCell>
