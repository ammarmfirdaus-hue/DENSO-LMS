      <mxCell id="zone_10334" value="2. BUAT TOPIK / BALASAN &amp; WEBP" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10335_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10335" value="3. MODERASI &amp; KONTROL SESI" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10336_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10336" value="4. SSE REALTIME EVENT STREAM" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10337" value="&lt;b&gt;BUKA MENU FORUM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="109" y="166" width="220" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10338" value="&lt;b&gt;Muat Daftar Course &amp;amp; Sesi Forum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /forum/management/courses (Scope RBAC)&lt;br&gt;Pilih sesi pembelajaran untuk buka topik diskusi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10339" value="&lt;b&gt;Muat Daftar Topik &amp;amp; Status Sesi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /forum/management/threads (10 per hal)&lt;br&gt;Cek status is_open pada sesi diskusi course&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10340" value="&lt;b&gt;Buka Detail Topik &amp;amp; 200 Balasan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /forum/threads/:id -&amp;gt; Muat header topik,&lt;br&gt;balasan aktif, file gambar &amp;amp; status like user&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="468" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10341" value="&lt;b&gt;Aksi Forum di&lt;br&gt;Halaman Staff?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="583" width="198" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10342" value="&lt;b&gt;Tulis Topik Baru atau Balasan Staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Judul 3-200 kar / Isi balasan 1-2000 kar&lt;br&gt;Opsional sertakan lampiran file gambar lokal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="166" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10343" value="&lt;b&gt;Ada Lampiran&lt;br&gt;Gambar?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="537" y="263" width="184" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10344" value="&lt;b&gt;Kompresi WebP &amp;amp; Validasi Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Client ubah ke format WebP ringan lalu kirim&lt;br&gt;Server cek Rate Limiter &amp;amp; parse buffer gambar&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="412" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10345" value="&lt;b&gt;Simpan ke dbo.forum_threads/replies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /forum/management/threads atau balasan&lt;br&gt;+ validasi status diskusi (tolak 423 bila tutup)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="534" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10346" value="&lt;b&gt;Toggle Like Topik atau Balasan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /forum/likes -&amp;gt; dbo.forum_likes&lt;br&gt;Hitung ulang COUNT_BIG(*) jumlah likes aktif&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="668" width="316" height="68" as="geometry"/></mxCell>
      <mxCell id="dia_10347" value="&lt;b&gt;Jenis Moderasi&lt;br&gt;Admin / Teacher?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="186" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10348" value="&lt;b&gt;Moderasi Status Thread Diskusi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;PATCH /forum/:id/status (Cek Origin valid)&lt;br&gt;Set visible, hidden, atau locked (tolak balasan&lt;br&gt;dengan status HTTP 423 pada Portal Student)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="338" width="312" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10349" value="&lt;b&gt;Validasi Akses Course &amp;amp; Sesi RBAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Periksa canAccessCourse &amp;amp; canAccessSession&lt;br&gt;Tolak akses lintas trainer dengan 404 / 403&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="464" width="312" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10350" value="&lt;b&gt;Buka / Kunci Diskusi Sesi Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;PATCH /forum/management/sessions/:c/:s&lt;br&gt;Set is_open=false -&amp;gt; Student menjadi Read-Only&lt;br&gt;dan mengembalikan 423 FORUM_CLOSED bila POST&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="883" y="586" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10351" value="&lt;b&gt;Terbitkan Forum Event Realtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kirim publishForumEvent berisi kode course,&lt;br&gt;kode sesi serta tipe aktivitas thread/balasan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="234" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10352" value="&lt;b&gt;Stream SSE /forum/events ke Klien&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Sebarkan pembaruan ke seluruh Admin, Teacher&lt;br&gt;dan Student pengakses course (25s heartbeat)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1291" y="370" width="316" height="80" as="geometry"/></mxCell>
