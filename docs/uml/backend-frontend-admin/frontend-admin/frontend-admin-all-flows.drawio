      <mxCell id="hdr_title" value="FLOWCHART 03 (ADMIN &amp; FRONTEND) - KELOLA COURSE, PENUGASAN TRAINER &amp; SESI" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="23" width="1024" height="26" as="geometry"/></mxCell>
