      <mxCell id="zone_10243" value="2. REKOMENDASI TEACHER" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10244_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
