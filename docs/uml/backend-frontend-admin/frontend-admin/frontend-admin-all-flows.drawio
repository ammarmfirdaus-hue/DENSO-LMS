      <mxCell id="proc_10199" value="&lt;b&gt;Ambil Daftar Course &amp;amp; Info Quiz&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /quizzes -&amp;gt; Gabung SQL Server courses&lt;br&gt;dengan MySQL course_quizzes &amp;amp; jumlah attempt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="244" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10200" value="&lt;b&gt;Cari, Filter Status &amp;amp; Pagination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Status: missing / draft / published / inactive&lt;br&gt;Auto-reload saat event Job Queue selesai&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="360" width="316" height="74" as="geometry"/></mxCell>
