      <mxCell id="zone_10245_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
