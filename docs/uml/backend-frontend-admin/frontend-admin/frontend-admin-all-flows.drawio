      <mxCell id="proc_10202" value="&lt;b&gt;Muat Detail Soal Quiz Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /quizzes/:courseCode (Cek akses course)&lt;br&gt;Isi form editor React dengan soal &amp;amp; opsi PG&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="164" width="316" height="76" as="geometry"/></mxCell>
