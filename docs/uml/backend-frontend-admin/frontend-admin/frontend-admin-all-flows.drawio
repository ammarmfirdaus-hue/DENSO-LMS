      <mxCell id="zone_10425" value="4. SINKRONISASI DUAL-DB &amp; HEALTH" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10426" value="&lt;b&gt;PORTAL NOTIF / SETTINGS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="160" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10427" value="&lt;b&gt;Koneksi SSE &amp;amp; Badge Unread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;EventSource /notifications/events (Max 3/user)&lt;br&gt;dan GET /notifications/unread-count di Header&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="63" y="244" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10428" value="&lt;b&gt;Terima Event&lt;br&gt;showPopup = true?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="126" y="358" width="186" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10429" value="&lt;b&gt;Tampilkan Modal Pengumuman &amp;amp; Toast&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Popup pengumuman penting di layar portal aktif&lt;br&gt;Klik Tandai Dibaca atau tutup jendela modal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="63" y="514" width="312" height="72" as="geometry"/></mxCell>
      <mxCell id="proc_10430" value="&lt;b&gt;Halaman /notifications &amp;amp; Filter Tab&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /notifications (All, Unread, Penting)&lt;br&gt;POST /read dan /read-all simpan ke tabel&lt;br&gt;dbo.lms_notification_reads&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="63" y="640" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10431" value="&lt;b&gt;Tulis Pesan Broadcast Pengumuman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Admin: pilih target admin, teacher, student&lt;br&gt;Teacher: hanya target Student + opsi popup&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="160" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10432" value="&lt;b&gt;Origin + Role +&lt;br&gt;Limit &amp;lt;= 10/jam OK?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="270" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10433" value="&lt;b&gt;Tolak HTTP 403 / 429 Limiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Batas pengiriman 10x/jam tercapai atau akses salah&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="424" width="316" height="62" as="geometry"/></mxCell>
      <mxCell id="proc_10434" value="&lt;b&gt;Simpan &amp;amp; Publish SSE Notification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /notifications -&amp;gt; INSERT lms_notifications&lt;br&gt;dan dorong event SSE ke seluruh target role&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="526" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10435" value="&lt;b&gt;Opsi sendEmail&lt;br&gt;Dicentang?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="536" y="639" width="186" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10436" value="&lt;b&gt;Kirim Batch Email SMTP (Outbox)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Nodemailer kirim email bertahap ke daftar&lt;br&gt;penerima aktif dengan alamat email valid&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="796" width="316" height="72" as="geometry"/></mxCell>
      <mxCell id="dia_10437" value="&lt;b&gt;Guard /settings/api&lt;br&gt;Role = Admin?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="944" y="168" width="190" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10438" value="&lt;b&gt;Akses Ditolak (Non-Admin)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Teacher diarahkan kembali ke Dashboard&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="894" y="330" width="290" height="56" as="geometry"/></mxCell>
      <mxCell id="term_10439" value="&lt;b&gt;AKSES SETTINGS DITOLAK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="919" y="424" width="240" height="42" as="geometry"/></mxCell>
      <mxCell id="proc_10440" value="&lt;b&gt;Muat Base URL &amp;amp; Status Sync Dual-DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /settings/api -&amp;gt; Info apiBaseUrl aktif,&lt;br&gt;koneksi MySQL Student, interval &amp;amp; lastSyncAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="886" y="502" width="306" height="78" as="geometry"/></mxCell>
