      <mxCell id="term_10152" value="&lt;b&gt;MULAI AJUKAN MATERI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="114" y="162" width="210" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10153" value="&lt;b&gt;Form Pengajuan Materi (7 Tipe)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pilih PDF, Video, YouTube, Image, Audio, Doc/Text&lt;br&gt;POST /sessions/:id/submissions (Max 250MB)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="232" width="316" height="84" as="geometry"/></mxCell>
      <mxCell id="proc_10154" value="&lt;b&gt;Validasi Zod &amp;amp; Magic-Byte Signature&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek header biner file &amp;amp; URL YouTube HTTPS&lt;br&gt;Jika tidak valid: hapus file &amp;amp; tolak 400 / 415&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="348" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10155" value="&lt;b&gt;Simpan Status = pending_admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Simpan ke dbo.material_submissions + Disk&lt;br&gt;Muncul di tab Menunggu Admin (/materials)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="460" width="316" height="68" as="geometry"/></mxCell>
      <mxCell id="proc_10156" value="&lt;b&gt;Revisi Ulang atau Hapus Pengajuan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Aturan Edit: hanya status rejected (Teacher)&lt;br&gt;PUT /submissions/:id kembali ke pending_admin&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="742" width="316" height="84" as="geometry"/></mxCell>
      <mxCell id="proc_10157" value="&lt;b&gt;Daftar Antrean Admin &amp;amp; Pratinjau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /material-workflow/submissions&lt;br&gt;Pratinjau Blob File atau player YouTube embed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="224" width="320" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10158" value="&lt;b&gt;Keputusan Admin&lt;br&gt;(pending_admin)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="353" width="198" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10159" value="&lt;b&gt;Kirim Undangan Magic-Link Reviewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /submissions/:id/send-review&lt;br&gt;Token SHA-256 (48j) + SMTP Email Reviewer&lt;br&gt;Status menjadi pending_review (Edit terkunci)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="486" width="320" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10160" value="&lt;b&gt;Admin Tolak + Catatan Perbaikan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /submissions/:id/admin-reject&lt;br&gt;Status = rejected + kirim notifikasi ke Trainer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="469" y="636" width="320" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10161" value="&lt;b&gt;Reviewer Buka /review/:token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /material-workflow/links/:token/consume&lt;br&gt;Verifikasi hash SHA-256 &amp;amp; cek masa berlaku 48j&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="162" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10162" value="&lt;b&gt;Token Valid &amp;amp;&lt;br&gt;Belum Expired?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="947" y="262" width="184" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10163" value="&lt;b&gt;Tolak Tautan Kadaluarsa (401/404)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Hapus sessionStorage reviewer &amp;amp; tampil&lt;br&gt;pesan tautan review sudah tak berlaku&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="891" y="412" width="296" height="66" as="geometry"/></mxCell>
      <mxCell id="proc_10164" value="&lt;b&gt;Terbit JWT Reviewer (Masa 2 Jam)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /reviewer/submissions &amp;amp; Pratinjau File&lt;br&gt;Tampil panel keputusan + riwayat revisi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="520" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10165" value="&lt;b&gt;Keputusan Akhir&lt;br&gt;Reviewer?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="944" y="630" width="190" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10166" value="&lt;b&gt;Reviewer Tolak (Catatan &amp;gt;= 3 Kar)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /reviewer/submissions/:id/decision&lt;br&gt;Status = rejected -&amp;gt; Notif perbaikan Trainer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="786" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="term_10167" value="&lt;b&gt;AKSES REVIEWER DITOLAK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1307" y="424" width="284" height="42" as="geometry"/></mxCell>
      <mxCell id="proc_10168" value="&lt;b&gt;Status = approved (Terkunci)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kirim notifikasi Admin siap publikasi&lt;br&gt;Pengajuan tak bisa diedit lagi oleh staf&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="520" width="312" height="72" as="geometry"/></mxCell>
