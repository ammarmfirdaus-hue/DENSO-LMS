      <mxCell id="proc_10064" value="&lt;b&gt;Transaksi Publish Dual-Table SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /submissions/:id/publish (Admin Only)&lt;br&gt;INSERT dbo.course_materials &amp;amp; status=published&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10065" value="&lt;b&gt;Sinkronkan ke MySQL Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Upsert course_materials MySQL beserta URL&lt;br&gt;/material-workflow/published/:materialId/file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="300" width="312" height="78" as="geometry"/></mxCell>
