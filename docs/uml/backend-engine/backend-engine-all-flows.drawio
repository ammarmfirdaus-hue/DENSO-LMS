      <mxCell id="hdr_title" value="FLOWCHART 03 (BACKEND ENGINE) - ANTREAN JOB AES-256-GCM, WORKER &amp; SSE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="23" width="1024" height="26" as="geometry"/></mxCell>
      <mxCell id="hdr_sub" value="Enkripsi AES-256-GCM 12B IV/16B Tag, Claim UPDLOCK/READPAST, Batas Item Stop/Resume &amp; SSE Last-Event-ID" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=10.2;" vertex="1" parent="1"><mxGeometry x="44" y="50" width="1024" height="20" as="geometry"/></mxCell>
      <mxCell id="leg_box" value="STANDAR ISO 5807 MONOKROM: Kapsul = Mulai / Selesai   |   Kotak = Proses / API / DB   |   Belah Ketupat = Keputusan   |   Putus-Putus = Async / SSE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1082" y="26" width="556" height="48" as="geometry"/></mxCell>
      <mxCell id="zone_10096_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="28" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10096" value="1. PRODUCER &amp; ENKRIPSI AES-GCM" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10097_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10097" value="2. CLAIM WORKER &amp; DEKRIPSI" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10098_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10098" value="3. HANDLER &amp; RE-ENCRYPT SISA" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10099_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10099" value="4. KONTROL STOP &amp; STREAM SSE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10100" value="&lt;b&gt;REQUEST BULK JOB (1..5000)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10101" value="&lt;b&gt;Validasi Zod &amp;amp; Scope Role API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /jobs/users (Admin/Teacher sesuai scope)&lt;br&gt;POST /jobs/records/delete (khusus Admin)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10102" value="&lt;b&gt;Enkripsi Payload AES-256-GCM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Key = SHA-256(JWT_SECRET), random 12B IV&lt;br&gt;dan 16B AuthTag guna amankan sandi pada payload&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10103" value="&lt;b&gt;Simpan dbo.lms_admin_jobs (queued)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Simpan ciphertext, IV &amp;amp; AuthTag ke SQL Server&lt;br&gt;Kembalikan HTTP 202 {jobId, status=&amp;quot;queued&amp;quot;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="468" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10104" value="&lt;b&gt;Catat Event Awal lms_admin_job_events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;appendEvent(jobId, 0, &amp;quot;Menunggu worker&amp;quot;)&lt;br&gt;Antrean siap diambil oleh background worker&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="582" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10105" value="&lt;b&gt;Polling Scheduler Worker Antrean&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Timer periodik admin-jobs.js dengan guard&lt;br&gt;inFlight=false agar eksekusi antrean aman&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10106" value="&lt;b&gt;Claim Job UPDLOCK READPAST ROWLOCK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;SELECT TOP(1) WHERE status=&amp;quot;queued&amp;quot; ORDER BY id&lt;br&gt;Update status=&amp;quot;running&amp;quot; &amp;amp; catat started_at SQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="290" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10107" value="&lt;b&gt;Ada Job queued&lt;br&gt;Berhasil Di-claim?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="532" y="385" width="194" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10108" value="&lt;b&gt;Dekripsi Ciphertext Item Array&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Verifikasi AuthTag AES-256-GCM &amp;amp; parse JSON&lt;br&gt;Ambil array items[0..] yang masih tersisa&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="534" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10109" value="&lt;b&gt;isStopping(jobId)&lt;br&gt;atau Items Habis?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="529" y="634" width="200" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10110" value="&lt;b&gt;Dispatch Handler Terdaftar Map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil handler dari handlers.get(job_type)&lt;br&gt;Siapkan context {ownerNpk, ownerRole, jobId}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="70" as="geometry"/></mxCell>
      <mxCell id="dia_10111" value="&lt;b&gt;Jenis Job:&lt;br&gt;users vs records?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="284" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10112" value="&lt;b&gt;Handler: user-job-handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Eksekusi upsert/delete/deactivate/email per NPK&lt;br&gt;Nonaktifkan akun bila memiliki riwayat LMS&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="414" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10113" value="&lt;b&gt;Handler: record-delete-job-handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;grade-&amp;gt;NULL+sync | quiz-&amp;gt;inactive/DELETE&lt;br&gt;material-&amp;gt;SQL tx + unlink file + is_active=0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="536" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10114" value="&lt;b&gt;Re-Encrypt Sisa Item &amp;amp; Simpan Progres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Enkripsi ulang sisa array items ke SQL Server&lt;br&gt;updateJobAfterItem() + INSERT event item baru&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="670" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10115" value="&lt;b&gt;Batas Aman Stop / Resume&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jika stopping -&amp;gt; set status=&amp;quot;stopped&amp;quot; lalu hentikan&lt;br&gt;POST /resume lanjutkan dari sisa ciphertext&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10116" value="&lt;b&gt;Finalisasi Status Akhir Job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jika item habis -&amp;gt; status=&amp;quot;completed&amp;quot; / &amp;quot;failed&amp;quot;&lt;br&gt;Catat finished_at &amp;amp; lepas lock worker inFlight&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="294" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10117" value="&lt;b&gt;Stream SSE GET /jobs/:id/events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Dukung header Last-Event-ID untuk reconnect&lt;br&gt;Poll dbo.lms_admin_job_events SQL tiap 1 detik&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="418" width="312" height="78" as="geometry"/></mxCell>
