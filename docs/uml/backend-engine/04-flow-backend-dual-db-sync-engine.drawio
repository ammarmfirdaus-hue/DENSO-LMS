      <mxCell id="term_10148" value="&lt;b&gt;PEMICU SINKRONISASI DB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="dia_10149" value="&lt;b&gt;Sumber Pemicu:&lt;br&gt;Timer vs Manual?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="238" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10150" value="&lt;b&gt;Periksa Global Lock inFlight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Timer interval STUDENT_SYNC_INTERVAL_MS&lt;br&gt;Atau Admin POST /settings/api/student-sync&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="396" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10151" value="&lt;b&gt;Proses Sinkron&lt;br&gt;Sedang inFlight?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="121" y="496" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10152" value="&lt;b&gt;Lewati Timer / HTTP 409 Manual&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jika manual -&amp;gt; HTTP 409 SYNC_IN_PROGRESS&lt;br&gt;Jika timer berkala -&amp;gt; skip siklus secara senyap&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="662" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10153" value="&lt;b&gt;Baca Katalog Aktif dari SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Query dbo.courses, dbo.course_sessions,&lt;br&gt;dan dbo.course_materials terbit dari MSSQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10154" value="&lt;b&gt;Mulai Transaksi MySQL &amp;amp; Upsert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT ... ON DUPLICATE KEY UPDATE courses dan&lt;br&gt;course_sessions; set course tak ada -&amp;gt; inactive&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="296" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10155" value="&lt;b&gt;Arsipkan Materi Dihapus (Batch 500)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Bandingkan source_material_id aktif MySQL vs SQL&lt;br&gt;Set is_active=0 agar tak mengunci Quiz Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="424" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10156" value="&lt;b&gt;Upsert Materi &amp;amp; URL File Dinamis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Bangun URL dari runtime system_settings API URL&lt;br&gt;+/material-workflow/published/:id/file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="554" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10157" value="&lt;b&gt;COMMIT Transaksi MySQL Katalog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Commit perubahan katalog ke MySQL Student;&lt;br&gt;bila terjadi error -&amp;gt; ROLLBACK penuh transaksi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="682" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10158" value="&lt;b&gt;Baca Progres Belajar &amp;amp; Quiz MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Query course_enrollments + student_accounts +&lt;br&gt;courses (progress, enrollment_status, quiz_score)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10159" value="&lt;b&gt;MERGE Snapshot Progres ke MSSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;MERGE dbo.student_progress_snapshots berdasar&lt;br&gt;kunci unik (student_npk, course_code)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="304" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10160" value="&lt;b&gt;Timestamp MySQL&lt;br&gt;&amp;gt;= Snapshot SQL?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="406" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10161" value="&lt;b&gt;Update atau Insert Snapshot Baru&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Simpan progress, status &amp;amp; quiz_score terbaru&lt;br&gt;atau INSERT baris snapshot baru beserta synced_at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="568" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10162" value="&lt;b&gt;Baca Nilai Instruktur dari MSSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil score, grade_feedback &amp;amp; graded_at dari&lt;br&gt;dbo.student_progress_snapshots untuk push balik&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10163" value="&lt;b&gt;Jalur Reverse Sync:&lt;br&gt;Periodik vs Paksa?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1349" y="270" width="200" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10164" value="&lt;b&gt;syncStudentGradeNow() Langsung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Dipanggil PATCH/DELETE grade &amp;amp; antrean job hapus&lt;br&gt;Tetap berjalan meski sync periodik dimatikan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="426" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10165" value="&lt;b&gt;UPDATE course_enrollments MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Update kolom score, grade_feedback &amp;amp; graded_at&lt;br&gt;berdasarkan NPK student + course_code terkait&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="552" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10166" value="&lt;b&gt;Lepas inFlight &amp;amp; Catat Status Sync&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Set inFlight=false, simpan lastSyncAt &amp;amp; Error&lt;br&gt;Tersedia dipantau lewat GET /settings/api&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="680" width="312" height="78" as="geometry"/></mxCell>
