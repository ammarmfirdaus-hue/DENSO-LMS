      <mxCell id="proc_10050" value="&lt;b&gt;Multer DiskStorage &amp;amp; UploadLimiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;uploadLimiter 20/15m, file size limit 250MB&lt;br&gt;Simpan sementara di uploadDirectory UUID&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10051" value="&lt;b&gt;Tipe Materi:&lt;br&gt;File vs YouTube?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10052" value="&lt;b&gt;Inspeksi Magic Byte Header File&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;hasExpectedFileSignature(): validasi %PDF-, ftyp&lt;br&gt;MP4/QuickTime &amp;amp; EBML WebM agar tak spoof MIME&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="514" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10053" value="&lt;b&gt;Signature File&lt;br&gt;Sesuai Ekstensi?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="121" y="616" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10054" value="&lt;b&gt;Unlink File &amp;amp; HTTP 415 Ditolak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Hapus file fisik sementara dari server&lt;br&gt;Kembalikan 415 INVALID_FILE_CONTENT&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="774" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10055" value="&lt;b&gt;Simpan Draft Status pending_admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;INSERT dbo.material_submissions + status awal&lt;br&gt;Admin juga bisa tolak via /admin-reject&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10056" value="&lt;b&gt;Triage Admin:&lt;br&gt;Tolak vs Review?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="529" y="273" width="200" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10057" value="&lt;b&gt;Tandai rejected &amp;amp; Catatan Revisi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Update status=&amp;quot;rejected&amp;quot; (Admin / Reviewer)&lt;br&gt;Blokir edit jika status approved / published&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="434" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10058" value="&lt;b&gt;Edit Matriks Role PUT /:id&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Teacher: hanya edit status rejected&lt;br&gt;Admin: boleh edit pending_admin atau rejected&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="552" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10059" value="&lt;b&gt;Revisi Diubah &amp;amp;&lt;br&gt;Ajukan Ulang?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="656" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10060" value="&lt;b&gt;Buat Token Review SHA-256 (48 Jam)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /send-review -&amp;gt; hash SHA-256 token 48j&lt;br&gt;Kirim email magic link SMTP &amp;amp; set pending_review&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10061" value="&lt;b&gt;Konsumsi Token &amp;amp; Reviewer JWT 2 Jam&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /links/:token/consume (single-use link)&lt;br&gt;Terbitkan Reviewer JWT durasi 2 jam ke client&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="300" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10062" value="&lt;b&gt;Keputusan di Portal Reviewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET/POST /reviewer/submissions/:id/decision&lt;br&gt;Verifikasi JWT Reviewer &amp;amp; simpan catatan review&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="426" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10063" value="&lt;b&gt;Hasil Keputusan&lt;br&gt;Reviewer?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="528" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10064" value="&lt;b&gt;Transaksi Publish Dual-Table SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;POST /submissions/:id/publish (Admin Only)&lt;br&gt;INSERT dbo.course_materials &amp;amp; status=published&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10065" value="&lt;b&gt;Sinkronkan ke MySQL Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Upsert course_materials MySQL beserta URL&lt;br&gt;/material-workflow/published/:materialId/file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="300" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10066" value="&lt;b&gt;Admin / Teacher&lt;br&gt;Hapus Materi?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="406" width="198" height="76" as="geometry"/></mxCell>
