      <mxCell id="term_10005" value="&lt;b&gt;HTTP REQUEST MASUK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10006" value="&lt;b&gt;X-Response-Time, Helmet &amp;amp; CORS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Matikan x-powered-by &amp;amp; ukur latensi respons&lt;br&gt;Cek origin di FRONTEND_ORIGIN / STUDENT_APP_URL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10007" value="&lt;b&gt;Melebihi Kuota&lt;br&gt;Rate Limiter?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="356" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10008" value="&lt;b&gt;Tolak HTTP 429 RATE_LIMITED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;apiLimiter 300/60s, writeLimiter 90/15m non-GET&lt;br&gt;Kirim Retry-After; mencakup uploadLimiter 20/15m&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="526" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10009" value="&lt;b&gt;Pagination &amp;amp; Body JSON Parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Terapkan paginationMiddleware &amp;amp; JSON limit 8mb&lt;br&gt;Atau stream Multer upload max 250MB per file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10010" value="&lt;b&gt;Endpoint Perlu&lt;br&gt;Middleware Auth?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="278" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10011" value="&lt;b&gt;Ekstrak Bearer / Cookie dls_sso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Baca header Authorization Bearer token,&lt;br&gt;atau parse cookie HTTP-only dls_sso dari request&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="448" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10012" value="&lt;b&gt;Verifikasi Signature JWT HS256&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek JWT_SECRET, issuer, audience &amp;amp; exp claim&lt;br&gt;Gagal verifikasi -&amp;gt; langsung HTTP 401 INVALID_TOKEN&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="574" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10013" value="&lt;b&gt;Jalankan Endpoint Publik Terbuka&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET /health, /settings/runtime-config, /auth/login&lt;br&gt;dan /material-workflow/links/:token/consume&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="706" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10014" value="&lt;b&gt;Role Token =&lt;br&gt;Student / Staff?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="939" y="195" width="200" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10015" value="&lt;b&gt;Cek Sesi &amp;amp; Identitas Student MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Validasi student_id &amp;gt;= 1 &amp;amp; pasangan mode/source_role&lt;br&gt;Panggil isStudentSessionActive() ke database MySQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="368" width="316" height="82" as="geometry"/></mxCell>
      <mxCell id="dia_10016" value="&lt;b&gt;Status Student&lt;br&gt;Aktif &amp;amp; DB Up?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="484" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10017" value="&lt;b&gt;Tolak Student (401 / 503)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;401 STUDENT_SESSION_REVOKED atau INVALID&lt;br&gt;503 STUDENT_IDENTITY_UNAVAILABLE bila MySQL down&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="650" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10018" value="&lt;b&gt;Pasang req.user &amp;amp; allowRoles()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Isi req.user {sub, role, mode, source_role}&lt;br&gt;Tolak role tidak sesuai -&amp;gt; HTTP 403 FORBIDDEN&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10019" value="&lt;b&gt;Write Endpoint:&lt;br&gt;Origin Terpercaya?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="1347" y="277" width="204" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10020" value="&lt;b&gt;Eksekusi Controller &amp;amp; Validasi Zod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jalankan route handler (SQL Server / MySQL)&lt;br&gt;Validasi Zod schema -&amp;gt; HTTP 200 / 201 / 202&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="448" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10021" value="&lt;b&gt;notFound (404) &amp;amp; errorHandler()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tangkap error async/Multer/Zod -&amp;gt; JSON {error}&lt;br&gt;Log detail dev, sembunyikan detail internal di prod&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="580" width="312" height="78" as="geometry"/></mxCell>
