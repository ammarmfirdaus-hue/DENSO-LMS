      <mxCell id="proc_10090" value="&lt;b&gt;Tampilkan Halaman Terkunci&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Course berstatus terkunci bagi akun Student&lt;br&gt;Tampilkan status pending/rejected &amp;amp; form ajukan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10091" value="&lt;b&gt;POST Form &amp;amp;&lt;br&gt;verifyCsrf() Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="274" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10092" value="&lt;b&gt;Cek Panjang request_note &amp;lt;= 1000&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jika melebihi 1000 kar -&amp;gt; error inline&lt;br&gt;Tentukan requesterRole: teacher atau student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="424" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10093" value="&lt;b&gt;Kirim apiRequestStudentCourseAccess()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Panggil backend enrollment request + 303 redirect&lt;br&gt;Tunggu Teacher/Admin menyetujui di menu Enrollment&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="540" width="316" height="82" as="geometry"/></mxCell>
