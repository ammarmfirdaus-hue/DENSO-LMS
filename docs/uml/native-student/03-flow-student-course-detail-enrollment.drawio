      <mxCell id="term_10085" value="&lt;b&gt;BUKA /student/course/detail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10086" value="&lt;b&gt;Validasi course_id &amp;amp; Parameter tab&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan courseId &amp;lt;= 80 kar; izinkan 5 nilai tab:&lt;br&gt;materi | quiz | forum | riwayat | capaian&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10087" value="&lt;b&gt;Ambil Objek Course Terstruktur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;DX_LMS_M_Student_Data::getCourseById(courseId)&lt;br&gt;Memuat daftar sesi, materi, quiz, forum &amp;amp; nilai&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="76" as="geometry"/></mxCell>
