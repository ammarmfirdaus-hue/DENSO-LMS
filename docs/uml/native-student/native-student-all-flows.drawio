      <mxCell id="zone_10207" value="2. TOPIK BARU (/forum/new)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10208_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10208" value="3. DETAIL THREAD (/forum/thread)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10209_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10209" value="4. KONTROL MODERASI &amp; SSE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10210" value="&lt;b&gt;BUKA TAB FORUM COURSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10211" value="&lt;b&gt;DX_LMS_T_Student_Forum_Category&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek course_id, session_id &amp;amp; category_type&lt;br&gt;Jika category_type !== &amp;quot;materi&amp;quot; -&amp;gt; redirect 303&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10212" value="&lt;b&gt;Cari Sesi &amp;amp; Daftar Thread Sesi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Verifikasi sessionData pada getCourseById()&lt;br&gt;Muat daftar topik sesi dari Forum Backend API&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10213" value="&lt;b&gt;Aksi Student:&lt;br&gt;Buat vs Buka Topik?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="464" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10214" value="&lt;b&gt;Buka /student/forum/new&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;DX_LMS_T_Student_Forum_New::index()&lt;br&gt;Siapkan form judul, isi &amp;amp; lampiran gambar opsional&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="210" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10215" value="&lt;b&gt;Kirim POST Thread ke API Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Upload multipart WebP jika ada gambar&lt;br&gt;Validasi judul/konten sebelum simpan ke MySQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="350" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10216" value="&lt;b&gt;Switch Sesi&lt;br&gt;is_open = true?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="518" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10217" value="&lt;b&gt;Tolak HTTP 423 FORUM_CLOSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Sesi forum sedang dikunci oleh Admin/Teacher&lt;br&gt;Tampilkan banner informasi sesi ditutup&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="650" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10218" value="&lt;b&gt;DX_LMS_T_Student_Forum_Thread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Validasi ctype_digit(id) &amp;gt;= 1, course_id &amp;amp;&lt;br&gt;session_id; muat detail topik &amp;amp; 200 balasan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10219" value="&lt;b&gt;Interaksi Balas &amp;amp; Like Topik&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kirim reply teks/gambar WebP atau toggle like&lt;br&gt;Pastikan thread status bukan locked / hidden&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="298" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10220" value="&lt;b&gt;Thread &amp;amp; Sesi&lt;br&gt;Terbuka (Visible)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="400" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10221" value="&lt;b&gt;Blokir Balas: 423 THREAD_CLOSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Topik dikunci atau disembunyikan moderator&lt;br&gt;Student tetap dapat membaca isi diskusi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="560" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10222" value="&lt;b&gt;Stream Realtime EventSource SSE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Berlangganan event thread, balasan &amp;amp; status sesi&lt;br&gt;Dari Backend SSE /forum/events dengan token SSO&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10223" value="&lt;b&gt;Update DOM Daftar Topik &amp;amp; Balasan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Sisipkan balasan baru, update jumlah like,&lt;br&gt;dan sinkronkan tombol jika switch sesi berubah&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="298" width="312" height="78" as="geometry"/></mxCell>
