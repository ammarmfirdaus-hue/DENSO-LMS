      <mxCell id="hdr_title" value="FLOWCHART 05 (NATIVE STUDENT) - PENGERJAAN QUIZ &amp; FINAL ASSESSMENT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="23" width="1024" height="26" as="geometry"/></mxCell>
      <mxCell id="hdr_sub" value="Deteksi type quiz/final_assessment, Kunci Prasyarat Materi/Sesi, Submit POST + CSRF &amp; Rekap Nilai Otomatis" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=10.2;" vertex="1" parent="1"><mxGeometry x="44" y="50" width="1024" height="20" as="geometry"/></mxCell>
      <mxCell id="leg_box" value="STANDAR ISO 5807 MONOKROM: Kapsul = Mulai / Selesai   |   Kotak = Proses / API / DB   |   Belah Ketupat = Keputusan   |   Putus-Putus = Async / SSE" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1082" y="26" width="556" height="48" as="geometry"/></mxCell>
      <mxCell id="zone_10165_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="28" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10165" value="1. VALIDASI &amp; CEK PRASYARAT" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="98" width="382" height="28" as="geometry"/></mxCell>
