      <mxCell id="zone_10166" value="2. KONFIGURASI SOAL &amp; KETERBUKAAN" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10167_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10167" value="3. SUBMIT JAWABAN (POST + CSRF)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10168_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10168" value="4. PENILAIAN &amp; STATUS KELULUSAN" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10169" value="&lt;b&gt;BUKA /student/quiz&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10170" value="&lt;b&gt;Validasi id, type &amp;amp; attempt Parameter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan type in [&amp;quot;quiz&amp;quot;, &amp;quot;final_assessment&amp;quot;]&lt;br&gt;Ambil getCourseById(id) atau balik ke /courses&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10171" value="&lt;b&gt;Course Live &amp;amp;&lt;br&gt;type = quiz?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="358" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10172" value="&lt;b&gt;Ambil Soal apiStudentCourseQuizDetails()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Query course_quizzes, course_quiz_questions&lt;br&gt;&amp;amp; status all_materials_completed dari MySQL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="520" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10173" value="&lt;b&gt;Cek $all_sessions_completed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Untuk final_assessment: buka kunci hanya jika&lt;br&gt;seluruh sesi &amp;amp; kuis prasyarat telah diselesaikan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="650" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10174" value="&lt;b&gt;Status Quiz =&lt;br&gt;Terbuka (Unlock)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="176" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10175" value="&lt;b&gt;Blokir &amp;amp; Tampilkan Status Terkunci&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Selesaikan semua materi sesi terlebih dahulu&lt;br&gt;Tampilkan informasi progres syarat kelayakan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="328" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10176" value="&lt;b&gt;Render View DX_LMS_T_Student_Quiz&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan daftar soal, passing_score (75),&lt;br&gt;dan form jawaban + hidden CSRF token&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="450" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10177" value="&lt;b&gt;Student Kirim&lt;br&gt;Jawaban POST?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="562" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10178" value="&lt;b&gt;Guard verifyCsrf() &amp;amp; Parse answers[]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Jika token CSRF tidak sah -&amp;gt; HTTP 403 exit&lt;br&gt;Ekstrak array $_POST[answers] pilihan student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10179" value="&lt;b&gt;Eksekusi apiSubmitStudentCourseQuiz()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Hitung skor otomatis dari kunci jawaban MySQL&lt;br&gt;Simpan ke tabel course_quiz_attempts &amp;amp; enrollments&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="300" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10180" value="&lt;b&gt;Simpan Database&lt;br&gt;Sukses?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="406" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10181" value="&lt;b&gt;Redirect 303 ke Halaman Hasil Quiz&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Header Location ?route=/student/quiz&amp;amp;type=quiz&lt;br&gt;Atau tangkap PDOException -&amp;gt; pesan error aman&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="566" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10182" value="&lt;b&gt;Bandingkan Skor vs Passing Score&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan nilai quiz_score, passing_score,&lt;br&gt;status Lulus / Belum Lulus &amp;amp; evaluasi soal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10183" value="&lt;b&gt;Worker Sinkron Nilai ke SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;student-sync MERGE quiz_score ke tabel&lt;br&gt;dbo.student_progress_snapshots untuk Admin/Teacher&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="304" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10184" value="&lt;b&gt;Lihat Rincian Nilai / Riwayat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Nilai masuk ke rekap /student/nilai&lt;br&gt;Jika 100% rampung -&amp;gt; masuk /student/riwayat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="434" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="term_10185" value="&lt;b&gt;HASIL EVALUASI QUIZ TERCATAT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="879" y="920" width="320" height="44" as="geometry"/></mxCell>
      <mxCell id="edge_10186" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.6;labelBackgroundColor=#ffffff;labelBorderColor=none;fontColor=#000000;fontSize=9.8;fontStyle=1;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="term_10169" target="proc_10170"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
