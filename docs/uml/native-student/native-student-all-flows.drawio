      <mxCell id="proc_10290" value="&lt;b&gt;DX_LMS_M_Student_Profil::index()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil getStats(), getEmployeeProfile(),&lt;br&gt;getLearningStats() &amp;amp; getGolonganMap() karyawan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="418" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10291" value="&lt;b&gt;Subhalaman&lt;br&gt;Profil Dipilih?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="528" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10292" value="&lt;b&gt;/student/profil/detail (Karier)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil getCareerHistory(), golonganMap &amp;amp; belajar&lt;br&gt;Render tampilan DX_LMS_M_Student_Profil_Detail&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10293" value="&lt;b&gt;/student/profil/pengaturan (Keamanan)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil getLoginHistory() &amp;amp; preferensi akun&lt;br&gt;Render DX_LMS_M_Student_Profil_Pengaturan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="296" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10294" value="&lt;b&gt;/student/profil/bantuan (Support)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Muat panduan penggunaan portal &amp;amp; kontak tim&lt;br&gt;Render DX_LMS_M_Student_Profil_Bantuan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="418" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="dia_10295" value="&lt;b&gt;Aksi Akun:&lt;br&gt;Teacher Mode/Logout?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="529" y="528" width="200" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10296" value="&lt;b&gt;teacherMode(): Cek POST, CSRF &amp;amp; Token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan $_SESSION[sso_mode]=&amp;quot;teacher_student&amp;quot;&lt;br&gt;Verifikasi klaim JWT source_role=&amp;quot;teacher&amp;quot;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10297" value="&lt;b&gt;Relay POST /api/v1/auth/teacher-mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Terbitkan ulang cookie HTTP-only dls_sso Teacher&lt;br&gt;Bersihkan sesi student &amp;amp; redirect 303 ke React&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="296" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10298" value="&lt;b&gt;logout(): GET Konfirmasi / POST Hapus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET -&amp;gt; DX_LMS_M_Auth_Logout_Confirm view&lt;br&gt;POST + verifyCsrf() -&amp;gt; hapus cookie, session &amp;amp; 303&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="424" width="316" height="78" as="geometry"/></mxCell>
