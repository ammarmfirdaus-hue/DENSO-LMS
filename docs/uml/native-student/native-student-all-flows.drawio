      <mxCell id="proc_10249" value="&lt;b&gt;Guard Sesi requireStudent() &amp;amp; Stats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan user login student valid &amp;amp; ambil stats&lt;br&gt;Header sinkronkan jumlah unread notification badge&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="76" as="geometry"/></mxCell>
