      <mxCell id="zone_10002" value="2. FORM LOGIN &amp; CSRF / RATE-LIMIT" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10003_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10003" value="3. RELAY SSO KE BACKEND API" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="zone_10004_frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="1034" as="geometry"/></mxCell>
      <mxCell id="zone_10004" value="4. SESI STUDENT &amp; PORTAL AKTIF" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1258" y="98" width="382" height="28" as="geometry"/></mxCell>
      <mxCell id="term_10005" value="&lt;b&gt;AKSES PORTAL STUDENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10006" value="&lt;b&gt;DX_LMS_M_Request_Middleware::handle()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;startAppSession() &amp;amp; cek limit 180 req / 60 detik&lt;br&gt;Melebihi kuota -&amp;gt; HTTP 429 + Retry-After header&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10007" value="&lt;b&gt;Ada Session atau&lt;br&gt;Cookie dls_sso?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="358" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10008" value="&lt;b&gt;verifySsoToken() &amp;amp; Cek Aktif&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Verifikasi JWT dls_sso &amp;amp; isSsoStudentIdentityActive()&lt;br&gt;Jika role admin/teacher -&amp;gt; redirect SSO_FRONTEND_URL&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="520" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10009" value="&lt;b&gt;Sesi Valid &amp;amp;&lt;br&gt;Role Student?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="630" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10010" value="&lt;b&gt;Render View DX_LMS_M_Auth_Login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan form NPK &amp;amp; kata sandi + token CSRF&lt;br&gt;Tangani banner error=rate, sso, atau invalid&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10011" value="&lt;b&gt;Request POST &amp;amp;&lt;br&gt;CSRF Token Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="274" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10012" value="&lt;b&gt;Tolak HTTP 403 &amp;amp; Null-Byte Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Gagal verifyCsrf() atau input mengandung null-byte&lt;br&gt;Hentikan proses agar bebas CSRF / injection&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="424" width="316" height="68" as="geometry"/></mxCell>
      <mxCell id="proc_10013" value="&lt;b&gt;Cek Rate-Limit login_rate_limits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Hitung key HMAC-SHA256 IP+NPK di tabel rate-limit&lt;br&gt;Jika &amp;gt;= 8 kali gagal dalam 15 menit -&amp;gt; lock&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="536" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10014" value="&lt;b&gt;Akun Terkunci&lt;br&gt;(&amp;gt;= 8 Percobaan)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="532" y="646" width="194" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10015" value="&lt;b&gt;Relay POST /api/v1/auth/login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kirim kredensial ke Express Backend (timeout 10s)&lt;br&gt;Terapkan cookie forwarding &amp;amp; validasi koneksi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10016" value="&lt;b&gt;Backend Up &amp;amp;&lt;br&gt;Kredensial Sah?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="941" y="276" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10017" value="&lt;b&gt;Catat Gagal / Redirect ?error=sso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Timeout/down -&amp;gt; ?error=sso (tak tambah counter)&lt;br&gt;Kredensial salah -&amp;gt; increment attempt &amp;amp; redirect&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="434" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10018" value="&lt;b&gt;Validasi role=student &amp;amp; student_id&amp;gt;=1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Pastikan payload akun merupakan student aktif&lt;br&gt;Atau akun bayangan mode teacher_student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="566" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10019" value="&lt;b&gt;Regenerate ID &amp;amp; Simpan $_SESSION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Set $_SESSION[user], student_id, student_npk&lt;br&gt;dan sso_mode (normal atau teacher_student)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="82" as="geometry"/></mxCell>
      <mxCell id="proc_10020" value="&lt;b&gt;Reset Rate-Limit &amp;amp; Catat History&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Hapus entri percobaan gagal dari login_rate_limits&lt;br&gt;Simpan riwayat login ke profil Student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="308" width="312" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10021" value="&lt;b&gt;Redirect 303 ke /student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Router jalankan DX_LMS_T_Student_Dashboard&lt;br&gt;Muat statistik belajar &amp;amp; pengumuman aktif&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="440" width="312" height="76" as="geometry"/></mxCell>
