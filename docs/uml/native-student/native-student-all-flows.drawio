      <mxCell id="term_10049" value="&lt;b&gt;MASUK PORTAL STUDENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10050" value="&lt;b&gt;Cek $_SESSION[user][role]=student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Validasi sesi pengguna student &amp;amp; muat getStats()&lt;br&gt;Jika tidak valid -&amp;gt; redirect ke ?route=/login&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10051" value="&lt;b&gt;Menu Navigasi:&lt;br&gt;Beranda/Course/Filter?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="120" y="373" width="198" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10052" value="&lt;b&gt;Ambil Semua Course &amp;amp; Filter Aktif&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;DX_LMS_M_Student_Data::getCourses()&lt;br&gt;Saring hanya course status=&amp;quot;sedang_dipelajari&amp;quot;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10053" value="&lt;b&gt;Urutkan Terakhir Diakses &amp;amp; Progres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;usort() last_accessed DESC, jika waktu sama&lt;br&gt;urutan memakai progress DESC (kemajuan tertinggi)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="296" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10054" value="&lt;b&gt;Render DX_LMS_T_Student_Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan KPI getStats() &amp;amp; kartu lanjutkan belajar&lt;br&gt;Klik kartu course -&amp;gt; buka ?route=/student/course/detail&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="424" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10055" value="&lt;b&gt;Ambil Course Belum Selesai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Filter getCourses() dimana status !== &amp;quot;selesai&amp;quot;&lt;br&gt;Susun daftar kelas yang tersedia dan aktif diikuti&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10056" value="&lt;b&gt;Urut Status: Dipelajari -&amp;gt; Belum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Prioritas 1: sedang_dipelajari, 2: belum_dimulai&lt;br&gt;Lalu urutkan menurun berdasarkan progress (%)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="296" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="proc_10057" value="&lt;b&gt;Bangun 6 Quick Filter Tag Stabil&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Kumpulkan filter unik (!==&amp;quot;semua&amp;quot;), natural sort&lt;br&gt;Ambil 6 teratas untuk chip filter cepat header&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="424" width="316" height="80" as="geometry"/></mxCell>
      <mxCell id="dia_10058" value="&lt;b&gt;Cari Keyword atau&lt;br&gt;Klik Kartu Course?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="536" width="198" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10059" value="&lt;b&gt;Render DX_LMS_M_Student_Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Filter live keyword &amp;amp; kategori di client-side&lt;br&gt;Klik kartu -&amp;gt; ?route=/student/course/detail&amp;amp;id=...&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="692" width="316" height="74" as="geometry"/></mxCell>
      <mxCell id="proc_10060" value="&lt;b&gt;Ekstrak Kategori Tag dari Course&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Ambil semua tag filters dari activeCourses&lt;br&gt;Urutkan natcasesort() agar daftar tag konsisten&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="174" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10061" value="&lt;b&gt;Render DX_LMS_M_Student_Filters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tampilkan indeks lengkap seluruh kategori pelatihan&lt;br&gt;Pilih kategori -&amp;gt; kembali ke daftar course terfilter&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="296" width="312" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10062" value="&lt;b&gt;Endpoint Katalog API /api/index.php&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;GET ?resource=courses / dashboard / me (JSON)&lt;br&gt;Memudahkan inspeksi data terstruktur student&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="424" width="312" height="78" as="geometry"/></mxCell>
