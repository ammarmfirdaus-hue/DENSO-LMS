      <mxCell id="proc_10138" value="&lt;b&gt;Redirect 303 &amp;amp; Completed Banner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Arahkan 303 ke URL materi + &amp;amp;completed=1&lt;br&gt;Atau tampilkan pesan completionError aman&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="548" width="316" height="76" as="geometry"/></mxCell>
