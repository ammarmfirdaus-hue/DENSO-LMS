      <mxCell id="term_10127" value="&lt;b&gt;BUKA /student/learning&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.3;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="107" y="166" width="224" height="44" as="geometry"/></mxCell>
      <mxCell id="proc_10128" value="&lt;b&gt;Validasi id, session_id &amp;amp; material_index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Cek id &amp;lt;= 80 kar, session_id valid &amp;amp;&lt;br&gt;ctype_digit(material_index) non-negatif&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="246" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10129" value="&lt;b&gt;Cari Sesi &amp;amp; Materi di getCourseById()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Temukan currentSession dan currentMaterial&lt;br&gt;pada index materi dalam course aktif / riwayat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="61" y="356" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10130" value="&lt;b&gt;Sesi &amp;amp; Materi&lt;br&gt;Ditemukan?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="121" y="458" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="dia_10131" value="&lt;b&gt;Tipe Konten:&lt;br&gt;PDF / Video / YT?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="531" y="176" width="196" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10132" value="&lt;b&gt;Stream Dokumen PDF via API Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Render iframe / viewer PDF dari endpoint&lt;br&gt;/material-workflow/published/:materialId/file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="332" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10133" value="&lt;b&gt;Pemutar Video MP4/WebM atau YouTube&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Render &amp;lt;video controls&amp;gt; dari API backend atau&lt;br&gt;embed aman iframe YouTube yang terverifikasi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="471" y="444" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="dia_10134" value="&lt;b&gt;Aksi Student:&lt;br&gt;Tandai Selesai?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontColor=#000000;fontSize=10.6;spacing=4;" vertex="1" parent="1"><mxGeometry x="529" y="548" width="200" height="76" as="geometry"/></mxCell>
      <mxCell id="proc_10135" value="&lt;b&gt;Guard POST + $isLiveCourse + CSRF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Tolak 403 jika bukan live course atau&lt;br&gt;verifyCsrf() gagal saat klik Tandai Selesai&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="174" width="316" height="78" as="geometry"/></mxCell>
      <mxCell id="proc_10136" value="&lt;b&gt;Panggil apiCompleteStudentMaterial()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.6px;font-weight:400&quot;&gt;Simpan penyelesaian ke material_progress MySQL&lt;br&gt;dan hitung ulang persentase progress course&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.6;fontColor=#000000;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="881" y="296" width="316" height="80" as="geometry"/></mxCell>
