  <diagram id="11-grades-progress-history" name="Nilai Course, Progres, Ekspor, dan Notifikasi">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Nilai Course, Progres, Ekspor, dan Notifikasi" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;Sumber data&lt;/b&gt;&lt;br&gt;MySQL menyimpan enrollment/progres dan quiz_score Student; SQL Server menyimpan snapshot, quiz_score, dan nilai course manual" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="75" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="&lt;b&gt;Sinkronisasi berkala&lt;/b&gt;&lt;br&gt;Enrollment/progres/quiz_score: MySQL ke SQL Server. Nilai course manual: SQL Server ke MySQL. Bukan transaksi lintas database." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="245" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="choice" value="&lt;b&gt;Siapa yang membuka?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="630" y="430" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="staff" value="&lt;b&gt;Admin / Teacher - /grades&lt;/b&gt;&lt;br&gt;API membatasi data menurut course yang dibuat/ditugaskan.&lt;br&gt;&lt;br&gt;Tampilkan quiz_score otomatis dan nilai course terpisah. Keduanya edit nilai course 0-100/feedback; Admin saja dapat mengosongkannya.&lt;br&gt;Ekspor XLSX memuat kedua nilai. Kirim notifikasi Student; email opsional masuk outbox/SSE." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="665" width="620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="student" value="&lt;b&gt;Student - /student/nilai&lt;/b&gt;&lt;br&gt;PHP membaca enrollment dan nilai Student yang sedang login dari MySQL.&lt;br&gt;&lt;br&gt;Menampilkan quiz_score otomatis, nilai course staff, feedback, progres, dan status course." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="825" y="665" width="620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.4;fontColor=#111111;fontSize=12;" edge="1" parent="1" source="source" target="sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.4;fontColor=#111111;fontSize=12;" edge="1" parent="1" source="sync" target="choice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Staff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.4;fontColor=#111111;fontSize=12;exitX=0.1;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="1" source="choice" target="staff">
