<mxfile host="app.diagrams.net" modified="2026-10-25T00:00:00.000Z" agent="DENSO LMS" version="24.7.17" type="device">
  <diagram id="pwa-system-architecture" name="Arsitektur Runtime PWA">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="DENSO LMS — PWA dan Arsitektur Runtime" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=23;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell>

        <mxCell id="staff-pwa" value="Browser Admin / Teacher / Reviewer&#xa;React + React Router + Vite&#xa;PWA: manifest, prompt install, service worker&#xa;Cache lokal hanya untuk aset publik/offline page" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="100" width="500" height="190" as="geometry"/></mxCell>
        <mxCell id="secure-note" value="HTTPS&#xa;SameSite / HttpOnly cookie&#xa;Origin SSO yang diset pada server" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="650" y="145" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="student-pwa" value="Browser Student&#xa;PHP views + JavaScript client&#xa;PWA: manifest, prompt install, service worker&#xa;Cache lokal hanya untuk aset publik/offline page" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="500" height="190" as="geometry"/></mxCell>

        <mxCell id="node-api" value="Backend API&#xa;Node.js / Express&#xa;SSO, role checks, course/workflow, grades, notifications, forum&#xa;Jobs persisted in SQL Server; SSE streams progress/events" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="330" y="410" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="php-app" value="Native Student application&#xa;PHP router, controllers, views, same-origin read API&#xa;Verifies SSO and reads Student courses, grades, progress&#xa;Forum/notifications use the connected backend API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1005" y="410" width="520" height="190" as="geometry"/></mxCell>

        <mxCell id="sqlserver" value="SQL Server&#xa;DX_LMS_AdminTeacher&#xa;Staff, course, workflow, grades snapshot, notifications, jobs/events" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="220" y="735" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="mysql" value="MySQL&#xa;dls_student&#xa;Student accounts, courses, enrollments, grades and progress" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="950" y="735" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="privacy" value="Service worker tidak menyimpan HTML akun, API, upload, atau job. Semua mutasi dan data terkini tetap memerlukan koneksi; offline hanya menampilkan fallback tanpa data pengguna." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#222222;strokeWidth=1.4;fillColor=#ffffff;fontColor=#111111;fontSize=14;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="330" y="920" width="870" height="58" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTPS API / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#222222;strokeWidth=1.4;fontColor=#111111;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="staff-pwa" target="node-api"><mxGeometry relative="1" as="geometry"/></mxCell>
