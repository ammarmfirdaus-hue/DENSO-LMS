        <mxCell id="e3" value="API Student: forum, notifikasi, SSO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#222222;strokeWidth=1.4;fontColor=#111111;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="student-pwa" target="node-api"><mxGeometry relative="1" as="geometry"/></mxCell>
