<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-25T00:00:00.000Z" agent="DENSO LMS" version="24.7.17" type="device">
  <diagram id="denso-lms-role-coverage" name="Peta Aktor dan Fitur DENSO LMS">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DENSO LMS - Peta Aktor dan Cakupan Fitur" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=23;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Ringkasan kewenangan dan penyimpanan. Detail langkah dan keputusan ada di flow 01-15." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="1520" height="32" as="geometry" />
        </mxCell>
        <mxCell id="adminhead" value="ADMIN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="350" height="62" as="geometry" />
        </mxCell>
        <mxCell id="adminbody" value="Kelola akun semua role, termasuk CSV dan antrean akun.&#10;Buat course/sesi dan tetapkan trainer.&#10;Tinjau submission; kirim undangan reviewer; publish materi approved.&#10;Edit atau kosongkan nilai; ekspor XLSX.&#10;Kirim notifikasi ke audiens yang diizinkan.&#10;Moderasi forum dan sesi." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=18;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="195" width="350" height="690" as="geometry" />
        </mxCell>
        <mxCell id="teacherhead" value="TEACHER / TRAINER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="115" width="350" height="62" as="geometry" />
        </mxCell>
        <mxCell id="teacherbody" value="Lihat course yang dibuat atau ditugaskan; buat course/sesi.&#10;Ajukan materi dan pantau statusnya.&#10;Edit/nonaktifkan/hapus akun Student yang sudah ada.&#10;Edit nilai; tidak dapat menghapus nilai.&#10;Kirim notifikasi hanya kepada Student.&#10;Ikut forum sesuai akses course." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=18;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="430" y="195" width="350" height="690" as="geometry" />
        </mxCell>
        <mxCell id="reviewerhead" value="REVIEWER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="115" width="350" height="62" as="geometry" />
        </mxCell>
        <mxCell id="reviewerbody" value="Masuk dari tautan undangan satu kali.&#10;Lihat hanya submission yang ditugaskan.&#10;Pratinjau materi dan file.&#10;Approve atau reject disertai komentar.&#10;Tidak menerbitkan materi ke Student." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=18;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="195" width="350" height="690" as="geometry" />
        </mxCell>
        <mxCell id="studenthead" value="STUDENT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="115" width="350" height="62" as="geometry" />
        </mxCell>
        <mxCell id="studentbody" value="Masuk melalui SSO ke portal PHP.&#10;Jelajahi course aktif dan materi terbit.&#10;Simpan progres pembelajaran; lihat nilai resmi milik sendiri.&#10;Gunakan forum dan notifikasi online.&#10;Quiz/assessment masih demo; attempt dan score tidak tersimpan." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=18;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1210" y="195" width="350" height="690" as="geometry" />
        </mxCell>
        <mxCell id="systemsTitle" value="Layanan dan data lintas fitur" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="915" width="1520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sql" value="Backend Node.js + SQL Server&#10;Akun staff/reviewer, course, workflow materi, nilai snapshot, forum, notifikasi, dan job/event." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="MySQL Student&#10;Akun Student, course/sesi/materi sync, enrollment, nilai course, dan progres materi." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="555" y="960" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="external" value="SMTP + worker dan integrasi&#10;Email akun/notifikasi/reviewer melalui antrean. Sync MySQL/SQL Server opsional; PWA hanya cache aset publik." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="960" width="490" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>