        <mxCell id="csv" value="&lt;b&gt;Admin · impor / ekspor CSV&lt;/b&gt;&lt;br&gt;Impor memvalidasi kolom dan tiap baris; sandi diperlukan untuk akun baru. Ekspor mengikuti filter dan tidak mengekspor password/hash." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="495" y="735" width="410" height="190" as="geometry" />
        </mxCell>
        <mxCell id="bulk" value="&lt;b&gt;Bulk delete / nonaktif / email (Admin); delete/nonaktif Student (Teacher)&lt;/b&gt;&lt;br&gt;Job memproses item satu per satu. Email Admin wajib sandi baru: hash diperbarui lalu sandi itu dikirim. Delete dengan riwayat fallback ke nonaktif." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
