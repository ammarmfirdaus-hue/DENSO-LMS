        <mxCell id="crud" value="&lt;b&gt;Tambah / edit / aktifkan kembali&lt;/b&gt;&lt;br&gt;Validasi NPK, email, role, status, dan password baru untuk akun baru.&lt;br&gt;API menyimpan password sebagai bcrypt hash." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
