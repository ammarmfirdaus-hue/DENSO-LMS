        <mxCell id="list" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;Gabungkan akun staff SQL Server dan Student MySQL&lt;br&gt;Admin: semua role; Teacher: Student saja" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;spacing=10;" vertex="1" parent="1">
