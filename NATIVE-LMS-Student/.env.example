APP_ENV=development
APP_URL=http://127.0.0.1:8082
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dls_student
# Use a dedicated database account with access only to the student LMS database.
DB_USER=dls_student_app
DB_PASSWORD=
SESSION_NAME=DLS_STUDENT
SSO_API_URL=http://127.0.0.1:3001/api/v1
SSO_JWT_SECRET=
SSO_JWT_ISSUER=dls-admin-teacher-api
SSO_JWT_AUDIENCE=dls-admin-teacher-web
SSO_COOKIE_NAME=dls_sso
# Set the same parent domain on all production apps (for example .example.com).
SSO_COOKIE_DOMAIN=
SSO_FRONTEND_URL=http://127.0.0.1:5173
